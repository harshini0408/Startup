# ============================================================
# IGNITE° PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment: development | production | test
APP_ENV=development
DEBUG=true

# Database: PostgreSQL (production and local development)
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/ignite_db

# Frontend Application URL & Allowed CORS Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Service Provider: resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
FROM_EMAIL=Ignite° Studio <inquiries@ignite-studio.com>
LEAD_NOTIFICATION_EMAIL=founders@ignite-studio.com

# Security: Server-side secret used for hashing client IPs
IP_HASH_SECRET=replace-with-a-cryptographically-secure-random-secret-in-production

# Optional: Cloudflare Turnstile Secret Key (if anti-bot captcha enabled in future)
TURNSTILE_SECRET_KEY=
